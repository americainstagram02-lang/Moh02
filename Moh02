def initialize_google_session():
    try:
        source_chars = 'abcdefghijklmnopqrstuvwxyz'
        p1 = ''
        for _ in range(rr(7, 11)):
            p1 += cc(source_chars)
        p2 = ''
        for _ in range(rr(5, 10)):
            p2 += cc(source_chars)
        gh = ''
        for _ in range(rr(25, 40)):
            gh += cc(source_chars)
        
        req_headers = {
            'accept': '*/*',
            'accept-language': 'en-US,en;q=0.9',
            'content-type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'google-accounts-xsrf': '1',
            'user-agent': str(generate_user_agent())
        }
        
        init_req = requests.get(
            'https://accounts.google.com/signin/v2/usernamerecovery?flowName=GlifWebSignIn&flowEntry=ServiceLogin&hl=en-GB', 
            headers=req_headers
        )
        
        xtk = re.search(
            'data-initial-setup-data="%.@.null,null,null,null,null,null,null,null,null,&quot;(.*?)&quot;,null,null,null,&quot;(.*?)&', 
            init_req.text
        ).group(2)
        
        ck_data = {'__Host-GAPS': gh}
        
        payload = {
            'f.req': f'["{xtk}","{p1}","{p2}","{p1}","{p2}",0,0,null,null,"web-glif-signup",0,null,1,[],1]',
            'deviceinfo': '[null,null,null,null,null,"NL",null,null,null,"GlifWebSignIn",null,[],null,null,null,null,2,null,0,1,"",null,null,2,2]'
        }
        
        res_val = requests.post(
            "https://accounts.google.com/_/signup/validatepersonaldetails", 
            cookies=ck_data, 
            headers=req_headers, 
            data=payload
        )
        
        gtl = str(res_val.text).split('",null,"')[1].split('"')[0]
        ghs = res_val.cookies.get_dict()['__Host-GAPS']
        
        with open('session_data.txt', 'w') as f_out:
            f_out.write(f"{gtl}//{ghs}\n")
            
    except Exception:
        initialize_google_session()

